{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digibillmate-admin",
  "main": ".open-next/worker.js",

  // Must be >= 2024-09-23 for OpenNext; nodejs_compat gives the Node APIs
  // Next's server runtime expects.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Cloudflare Access is bound to a hostname, so it protects
  // websites.digibillmate.com and nothing else. The default
  // <worker>.workers.dev URL would serve the same admin app with no
  // Access check in front of it — an unprotected side door. Turning it
  // off means the custom domain is the only way in.
  "workers_dev": false,
  "preview_urls": false,

  // Attaches the custom domain on deploy and manages its DNS record, so the
  // hostname does not have to be wired up by hand in the dashboard. Requires
  // digibillmate.com to be an active zone on this Cloudflare account; if it
  // is not, the deploy fails with an explicit error rather than half-working.
  "routes": [
    {
      "pattern": "websites.digibillmate.com",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  },

  // Account id is not a secret — it appears in every dashboard URL — so it
  // lives here where it is visible and version-controlled, rather than as an
  // encrypted secret nobody can read back. CLOUDFLARE_API_TOKEN is the secret
  // and is set with `wrangler secret put`.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "3dd2599e471a6d14a7ee7d074ab46520",

    // Handed to every site this portal provisions, so their enquiry forms
    // post here. A property of the platform rather than of any one site.
    "ENQUIRY_ENDPOINT": "https://websites.digibillmate.com/api/enquiry"
  }

  // Secrets are NOT declared here. CLOUDFLARE_DEPLOY_HOOK_URL and
  // CLOUDFLARE_DEPLOY_HOOK_SITE_ID are set as encrypted secrets in the
  // Cloudflare dashboard (or `wrangler secret put`), so they never enter
  // version control. The NEXT_PUBLIC_* values are build-time inlined and
  // come from the build environment.
}
