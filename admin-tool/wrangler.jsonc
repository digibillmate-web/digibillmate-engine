{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digibillmate-admin",
  "main": ".open-next/worker.js",

  // Must be >= 2024-09-23 for OpenNext; nodejs_compat gives the Node APIs
  // Next's server runtime expects.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // Secrets are NOT declared here. CLOUDFLARE_DEPLOY_HOOK_URL and
  // CLOUDFLARE_DEPLOY_HOOK_SITE_ID are set as encrypted secrets in the
  // Cloudflare dashboard (or `wrangler secret put`), so they never enter
  // version control. The NEXT_PUBLIC_* values are build-time inlined and
  // come from the build environment.
}
