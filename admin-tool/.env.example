# Copy to admin-tool/.env.local and fill in. Never commit .env.local.

# Browser-visible. Anon key only — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — must never be exposed to the browser,
# so it is deliberately NOT prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Cloudflare Pages deploy hook, POSTed to trigger a build.
# Treat as a secret: anyone holding this URL can trigger deploys.
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your-hook-id

# The site this hook builds. A deploy hook has no site parameter — it
# rebuilds one fixed Pages project, which builds whatever that project's
# own SITE_ID points at. Setting this makes the publish route refuse to
# trigger the wrong project's build. Leave unset only while there is a
# single site.
CLOUDFLARE_DEPLOY_HOOK_SITE_ID=00000000-0000-0000-0000-000000000000
