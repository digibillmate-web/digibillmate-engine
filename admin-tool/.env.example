# Copy to admin-tool/.env.local and fill in. Never commit .env.local.

# Browser-visible. Anon key only — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: no SUPABASE_SERVICE_ROLE_KEY here on purpose. Every operation in
# this app runs on the signed-in user's session and is authorised by RLS —
# including image upload, which goes straight to Storage from the browser.
# A secret that is never deployed cannot leak.

# NOTE: no CLOUDFLARE_DEPLOY_HOOK_URL either. Deploy hooks are per-site and
# live in the site_deploy_hooks table (admin-only, migration 0008), set
# through the Site Editor. A single env var could only ever be correct for
# one site, and would rebuild the wrong one as soon as a second existed.
