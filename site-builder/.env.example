# Copy to site-builder/.env and fill in real values. Never commit .env.
# Astro loads .env from this directory, not the repo root.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server/build-time only. Bypasses RLS — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
