---
/**
 * Renders the exported Maria Cars site from real Supabase data.
 *
 * The JSON is produced by `npm run export:site -- <site_id>` at the repo root
 * and is gitignored — run the export before building. The fixture in
 * src/fixtures/ is kept only as a component-level reference.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import type { ExportedSite } from '../types/site';
import siteData from '../data/sites/mariacars.json';

const site = siteData as ExportedSite;
---

<SiteLayout title={`Maria Cars — ${site.subdomain}`} theme={site.theme}>
  <BlockRenderer blocks={site.blocks} />
</SiteLayout>
