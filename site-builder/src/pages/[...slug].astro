---
/**
 * Every page of the exported site.
 *
 * The JSON carries a `pages` array; each entry becomes one static route.
 * The home page has an empty slug and builds to /index.html, everything else
 * to /<slug>/index.html.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import type { ExportedSite, ExportedPage } from '../types/site';
import type { BlockContent } from '../types/blocks';
import { serviceAnchor } from '../lib/service-anchor';

/**
 * Blocks that belong to the whole site rather than to one page.
 *
 * Requiring an operator to add a header and footer to every page they create
 * would mean the chrome drifts apart the first time one copy is edited. A page
 * that has its own header or footer keeps it; otherwise it inherits the home
 * page's.
 */
const CHROME_BEFORE = ['floating_contact_bar', 'header_nav'];
const CHROME_AFTER = ['footer'];

function isChrome(block: BlockContent) {
  return CHROME_BEFORE.includes(block.type) || CHROME_AFTER.includes(block.type);
}

function pick(types: string[], page: ExportedPage) {
  return page.blocks.filter((block) => types.includes(block.type));
}

function composePage(
  page: ExportedPage,
  home: ExportedPage,
  detailServicesHref?: string,
  enquiryHref?: string,
): BlockContent[] {
  const ownBefore = pick(CHROME_BEFORE, page);
  const ownAfter = pick(CHROME_AFTER, page);

  const blocks = [
    ...(ownBefore.length > 0 ? ownBefore : pick(CHROME_BEFORE, home)),
    ...page.blocks.filter((block) => !isChrome(block)),
    ...(ownAfter.length > 0 ? ownAfter : pick(CHROME_AFTER, home)),
  ];

  return blocks.map((block) =>
    addEnquiryLink(
      linkServicesToDetail(
        fillPageBanner(markCurrentNav(block, page), page),
        detailServicesHref,
      ),
      enquiryHref,
    ),
  );
}

/**
 * Gives the detail layout somewhere to send an enquiry.
 *
 * Only the detail layout: the summary cards already link through to the
 * detail page, and a second call to action on a card that small competes with
 * the one that matters.
 */
function addEnquiryLink(block: BlockContent, enquiryHref?: string): BlockContent {
  if (block.type !== 'services_grid' || block.content.layout !== 'detail') return block;
  if (!enquiryHref) return block;

  return { ...block, content: { ...block.content, enquiryHref } };
}

/**
 * The page whose services_grid uses the detail layout, if any. That page is
 * where a summary card should send someone who wants to read more.
 */
function findDetailServicesHref(pages: ExportedPage[]): string | undefined {
  const match = pages.find((candidate) =>
    candidate.blocks.some(
      (block) => block.type === 'services_grid' && block.content.layout === 'detail',
    ),
  );

  if (!match) return undefined;
  return match.slug ? `/${match.slug}/` : '/';
}

/** The page carrying the enquiry form, which is where an enquiry should go. */
function findEnquiryHref(pages: ExportedPage[]): string | undefined {
  const match = pages.find((candidate) =>
    candidate.blocks.some((block) => block.type === 'enquiry_form'),
  );

  if (!match) return undefined;
  return match.slug ? `/${match.slug}/` : '/';
}

/**
 * Points each summary service card at its section on the services page.
 *
 * Done at render time because it needs the whole site: which page carries the
 * detail layout is not knowable from inside a block. Doing it here also means
 * the link survives renaming or moving that page, where a stored href would
 * quietly rot.
 *
 * An explicit href on a service still wins — a site may point a service at an
 * external booking page, and this only fills the gap.
 */
function linkServicesToDetail(
  block: BlockContent,
  detailServicesHref?: string,
): BlockContent {
  if (block.type !== 'services_grid' || block.content.layout === 'detail') return block;
  if (!detailServicesHref) return block;

  return {
    ...block,
    content: {
      ...block.content,
      services: block.content.services.map((service) => {
        if (service.href) return service;
        const anchor = serviceAnchor(service.title);
        return anchor ? { ...service, href: `${detailServicesHref}#${anchor}` } : service;
      }),
    },
  };
}

/**
 * Fills a page banner's title and breadcrumb from the page it sits on.
 *
 * Done here for the same reason as the nav's current marker: the page is only
 * known at render time. It also means adding a banner to a new page needs no
 * retyping, and a page renamed later cannot leave a stale title behind.
 */
function fillPageBanner(block: BlockContent, page: ExportedPage): BlockContent {
  if (block.type !== 'page_banner') return block;

  const title = block.content.title?.trim() || page.title;

  return {
    ...block,
    content: {
      ...block.content,
      title,
      breadcrumb: [
        { label: 'Home', href: '/' },
        { label: page.navLabel || page.title },
      ],
    },
  };
}

/**
 * Flags the nav link pointing at this page.
 *
 * Done here rather than in the export because an inherited header is the home
 * page's object: a flag baked in at export time would mark Home as current on
 * every page that inherits it. The block is copied rather than mutated, since
 * that same object is shared by every page inheriting it.
 */
function markCurrentNav(block: BlockContent, page: ExportedPage): BlockContent {
  if (block.type !== 'header_nav') return block;

  const links = block.content.navLinks;
  if (!links || links.length === 0) return block;

  const here = page.slug ? `/${page.slug}/` : '/';

  return {
    ...block,
    content: {
      ...block.content,
      navLinks: links.map((link) => ({ ...link, current: link.href === here })),
    },
  };
}

export async function getStaticPaths() {
  const exports = import.meta.glob<ExportedSite>('../data/sites/*.json', {
    eager: true,
    import: 'default',
  });

  const found = Object.entries(exports);

  if (found.length === 0) {
    throw new Error(
      'No site export found in src/data/sites/. Run `npm run build:site` from the ' +
        'repo root with SITE_ID set, or `npm run export:site -- <site_id>`.',
    );
  }

  if (found.length > 1) {
    throw new Error(
      `Expected exactly one site export in src/data/sites/, found ${found.length}: ` +
        `${found.map(([path]) => path).join(', ')}. One build renders one site — ` +
        'remove the extras (`npm run build:site` clears the directory first).',
    );
  }

  const [, site] = found[0]!;

  if (!site.pages || site.pages.length === 0) {
    throw new Error(
      'The site export has no pages. Re-run the export after applying ' +
        'supabase/migrations/0011_site_pages.sql.',
    );
  }

  const home = site.pages.find((page) => page.slug === '') ?? site.pages[0]!;

  return site.pages.map((page) => ({
    // An empty slug must be undefined, not '', for Astro to emit /index.html.
    params: { slug: page.slug || undefined },
    props: { site, page, home },
  }));
}

interface Props {
  site: ExportedSite;
  page: ExportedPage;
  home: ExportedPage;
}

const { site, page, home } = Astro.props;

/**
 * Browser tab title. The subdomain is a routing detail, not a name anyone
 * would choose to read in a tab, so it is only the last resort:
 *   1. an explicit seo-title from the theme
 *   2. the header's business name, which is already the brand
 *   3. the subdomain
 */
const headerContent = home.blocks.find((block) => block.type === 'header_nav')?.content as
  | { businessName?: string }
  | undefined;

const brand =
  site.theme['--dbm-seo-title']?.trim() ||
  headerContent?.businessName?.trim() ||
  site.subdomain;

// The home page is the brand; inner pages say what they are, then the brand.
const title = page.slug === '' ? brand : `${page.title} — ${brand}`;

const description = site.theme['--dbm-seo-description']?.trim() || undefined;

const blocks = composePage(
  page,
  home,
  findDetailServicesHref(site.pages),
  findEnquiryHref(site.pages),
);
---

<SiteLayout
  title={title}
  description={description}
  theme={site.theme}
  pageTheme={page.theme}
  revealAnimation={page.revealAnimation}
>
  <BlockRenderer blocks={blocks} />
</SiteLayout>
