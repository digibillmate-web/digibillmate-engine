---
import type { PageBannerContent } from '../../types/blocks';

type Props = PageBannerContent;

const { title, subtitle, image, breadcrumb, showBreadcrumb = true } = Astro.props;

/*
 * A graded scrim rather than a flat one.
 *
 * A single opacity has to serve two goals at once and fails both: dark enough
 * to carry a title over a busy photo leaves the photo looking switched off,
 * and light enough to show the photo leaves the title fighting it.
 *
 * Darkest through the middle band where the title and breadcrumb sit, easing
 * off top and bottom so the image is still visibly a photograph.
 */
const SCRIM = [
  'rgb(0 0 0 / 0.30) 0%',
  'rgb(0 0 0 / 0.62) 35%',
  'rgb(0 0 0 / 0.62) 65%',
  'rgb(0 0 0 / 0.30) 100%',
].join(', ');

const style = image
  ? `background-image: linear-gradient(${SCRIM}), url('${image.src}')`
  : undefined;
---

<section class="pagebanner" class:list={[{ 'pagebanner--photo': image }]} style={style}>
  <div class="dbm-container">
    <h1 class="pagebanner__title">{title}</h1>
    {subtitle && <p class="pagebanner__subtitle">{subtitle}</p>}

    {showBreadcrumb && breadcrumb && breadcrumb.length > 0 && (
      <nav class="pagebanner__crumb" aria-label="Breadcrumb">
        <ol>
          {breadcrumb.map((step, index) => (
            <li>
              {step.href && index < breadcrumb.length - 1 ? (
                <a href={step.href}>{step.label}</a>
              ) : (
                <span aria-current="page">{step.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>

<style>
  .pagebanner {
    background: var(--dbm-color-secondary);
    color: var(--dbm-color-secondary-contrast);
    /* The reference runs 140px top and bottom, giving the banner enough
       presence to read as a page header rather than a coloured strip. */
    padding-block: clamp(3.5rem, 11vw, 8.75rem);
    background-size: cover;
    background-position: center;
    text-align: center;
  }

  .pagebanner__title {
    font-family: var(--dbm-font-heading);
    font-size: var(--dbm-text-3xl);
    line-height: 1.15;
    margin: 0;
    color: inherit;
  }

  /* Lifts the text off whatever detail survives the scrim. */
  .pagebanner--photo .pagebanner__title,
  .pagebanner--photo .pagebanner__subtitle,
  .pagebanner--photo .pagebanner__crumb {
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.6);
  }

  .pagebanner__subtitle {
    margin: var(--dbm-space-xs) auto 0;
    max-width: 60ch;
    opacity: 0.85;
    color: inherit;
  }

  .pagebanner__crumb {
    margin-top: var(--dbm-space-sm);
    font-size: var(--dbm-text-sm);
  }

  .pagebanner__crumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0.9;
  }

  .pagebanner__crumb li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .pagebanner__crumb a {
    color: inherit;
    text-decoration: none;
  }

  .pagebanner__crumb a:hover {
    color: var(--dbm-color-primary);
  }

  .pagebanner__crumb [aria-current='page'] {
    color: var(--dbm-color-primary);
    font-weight: 600;
  }
</style>
