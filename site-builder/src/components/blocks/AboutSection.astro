---
import type { AboutSectionContent } from '../../types/blocks';

type Props = AboutSectionContent;

const { heading, body, image, readMore, bandHeight = 'medium' } = Astro.props;

// Blank lines in the stored text become paragraphs.
const paragraphs = body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

/*
 * An image with no heading and no copy is not an about section — it is the
 * full-width highlight band the reference runs above its footer. Rendered as
 * one, because the alternative is a boxed thumbnail beside an empty text
 * column, which is what it looks like today.
 *
 * Inferred rather than configured: there is nothing else this combination
 * could sensibly mean, and a setting would be one more thing to discover
 * before the block does anything useful.
 */
const isBand = Boolean(image) && !heading?.trim() && paragraphs.length === 0;
---

{isBand ? (
  <section
    class="aboutband"
    class:list={[`aboutband--${bandHeight}`]}
    id="about"
    aria-label={image!.alt || 'Highlight'}
  >
    <img src={image!.src} alt={image!.alt} loading="lazy" />
  </section>
) : (
<section class="about dbm-section" id="about">
  <div class="dbm-container about__inner" class:list={[{ 'about__inner--split': image }]}>
    {image && (
      <div class="about__media">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
    )}

    <div class="about__body">
      <h2 class="dbm-heading about__heading">{heading}</h2>
      {paragraphs.map((paragraph) => <p class="about__text">{paragraph}</p>)}
      {readMore && (
        <a class="dbm-btn dbm-btn--secondary about__more" href={readMore.href}>
          {readMore.label}
        </a>
      )}
    </div>
  </div>
</section>
)}

<style>
  /*
   * Full-bleed highlight band. No container and no section padding: it spans
   * the viewport edge to edge, the way the reference's strip above the footer
   * does. A fixed height with object-fit crops rather than letting a tall
   * image take over the page.
   */
  .aboutband {
    display: block;
    width: 100%;
  }

  .aboutband img {
    display: block;
    width: 100%;
    /* Set per height option below; medium is the default. */
    height: clamp(180px, 26vw, 320px);
    object-fit: cover;
  }

  .aboutband--short img {
    height: clamp(120px, 16vw, 200px);
  }

  .aboutband--tall img {
    height: clamp(260px, 38vw, 520px);
  }

  /*
   * Capped below the viewport rather than at it: a band exactly 100vh tall
   * fills the screen with no hint that the page continues, and reads as the
   * end of the site.
   */
  .aboutband--full img {
    height: min(80vh, 720px);
  }

  .about__inner--split {
    display: grid;
    gap: var(--dbm-space-xl);
    align-items: center;
  }

  .about__media img {
    width: 100%;
    border-radius: var(--dbm-radius-lg);
    box-shadow: var(--dbm-shadow-md);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /*
   * The about heading is the one that sits beside body copy rather than
   * over a centred section, and the reference left-aligns it there. No
   * accent rule: measured off the reference, which uses weight alone.
   */
  .about__heading {
    text-align: start;
  }

  .about__text {
    color: var(--dbm-color-text-muted);
    margin: 0 0 var(--dbm-space-md);
    max-width: 62ch;
  }

  .about__more {
    margin-top: var(--dbm-space-xs);
  }

  @media (min-width: 768px) {
    .about__inner--split {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>
