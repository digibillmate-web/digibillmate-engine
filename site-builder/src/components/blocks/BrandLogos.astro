---
import type { BrandLogosContent } from '../../types/blocks';

type Props = BrandLogosContent;

const { heading, brands } = Astro.props;
---

<section class="brands dbm-section">
  <div class="dbm-container">
    {heading && <h2 class="dbm-heading brands__heading">{heading}</h2>}
    <ul class="brands__grid" data-stagger>
      {brands.map((brand) => (
        <li class="brands__item">
          {brand.logo
            ? <img class="brands__logo" src={brand.logo.src} alt={brand.logo.alt || brand.name} loading="lazy" />
            : <span class="brands__name">{brand.name}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .brands {
    background: var(--dbm-color-surface);
  }

  .brands__heading {
    text-align: center;
  }

  .brands__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--dbm-space-md);
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    align-items: center;
  }

  .brands__item {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dbm-color-background);
    border: 1px solid var(--dbm-color-border);
    border-radius: var(--dbm-radius-md);
    padding: var(--dbm-space-md);
    min-height: 88px;
  }

  .brands__logo {
    max-height: 48px;
    width: auto;
    /* Desaturated by default so the strip reads as one unit, not a rainbow. */
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .brands__item:hover .brands__logo {
    filter: grayscale(0);
    opacity: 1;
  }

  .brands__name {
    font-weight: 600;
    color: var(--dbm-color-text-muted);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .brands__logo {
      transition: none;
    }
  }
</style>
