---
import type { EnquiryFormContent } from '../../types/blocks';

type Props = EnquiryFormContent;

const {
  title,
  intro,
  whatsappNumber,
  email,
  submitLabel = 'Send enquiry',
  serviceOptions,
  footnote,
} = Astro.props;

/**
 * Two ways to make contact, because the visitors differ.
 *
 * WhatsApp is how this category of business actually takes enquiries, and it
 * stays the primary action. But it is rarely installed on a desktop, so on a
 * PC the only visible button appeared to do nothing — and email was recorded
 * silently in the background where nobody knew to look for it.
 *
 * Email now posts to the platform's intake endpoint and reports back. Where
 * no endpoint is configured it falls back to the visitor's own mail client,
 * so the button always does something honest.
 */
const digits = whatsappNumber ? whatsappNumber.replace(/[^\d]/g, '') : '';
const hasWhatsapp = digits.length > 0;
const hasEmail = Boolean(email);

// Without either destination the form could collect input and silently drop
// it, which is worse than not rendering at all.
const canSend = hasWhatsapp || hasEmail;
---

<section class="enquiry dbm-section" id="enquiry">
  <div class="dbm-container">
    <h2 class="dbm-heading">{title}</h2>
    {intro && <p class="dbm-intro">{intro}</p>}

    {canSend ? (
      <form
        class="enquiry__form"
        data-enquiry
        data-whatsapp={hasWhatsapp ? digits : undefined}
        data-email={hasEmail ? email : undefined}
        data-subject={title}
      >
        <div class="enquiry__grid">
          <div class="enquiry__field">
            <label for="enq-name">Your name<span class="req">*</span></label>
            <input id="enq-name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="enquiry__field">
            <label for="enq-mobile">Mobile number<span class="req">*</span></label>
            <input
              id="enq-mobile"
              name="mobile"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
            />
          </div>

          <div class="enquiry__field">
            <label for="enq-email">Email</label>
            <input id="enq-email" name="email" type="email" autocomplete="email" />
          </div>

          {serviceOptions && serviceOptions.length > 0 && (
            <div class="enquiry__field">
              <label for="enq-service">Service needed</label>
              <select id="enq-service" name="service">
                <option value="">Not sure yet</option>
                {serviceOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>
          )}
        </div>

        <div class="enquiry__field">
          <label for="enq-message">Tell us about the work</label>
          <textarea id="enq-message" name="message" rows="4"></textarea>
        </div>

        {/*
          Honeypot. Hidden from people and from assistive tech, left visible to
          anything that fills every field it finds. aria-hidden and tabindex
          keep it out of the keyboard path, and autocomplete off stops a
          browser helpfully filling it in on a real visitor's behalf.
        */}
        <div class="enquiry__hp" aria-hidden="true">
          <label for="enq-website">Website</label>
          <input id="enq-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/*
          Two routes, two buttons.

          One button doing both was a desktop trap: WhatsApp is not installed
          on most PCs, so the only visible way to make contact appeared to be
          broken and nobody knew an email option existed at all.

          WhatsApp stays the primary action because that is how these
          customers actually make contact, but it is now honestly labelled as
          what it does.
        */}
        <div class="enquiry__actions">
          {hasWhatsapp && (
            <button class="dbm-btn dbm-btn--primary" type="submit" data-route="whatsapp">
              {submitLabel}
            </button>
          )}

          <button
            class:list={['dbm-btn', hasWhatsapp ? 'dbm-btn--secondary' : 'dbm-btn--primary']}
            type="submit"
            data-route="email"
          >
            Send by email
          </button>
        </div>

        <p class="enquiry__route">
          {hasWhatsapp
            ? 'WhatsApp opens the app with your details filled in. Email sends it to us directly — no app needed.'
            : 'Sends your enquiry to us directly.'}
        </p>

        {/* Announced, not just shown: someone using a screen reader needs to
            know the enquiry landed without hunting for the sentence. */}
        <p class="enquiry__status" data-enquiry-status role="status" aria-live="polite"></p>

        {footnote && <p class="enquiry__footnote">{footnote}</p>}
      </form>
    ) : (
      <p class="enquiry__unconfigured">
        This form has no WhatsApp number or email address set, so it has nowhere to send
        enquiries.
      </p>
    )}
  </div>
</section>

<style>
  .enquiry__form {
    max-width: 720px;
  }

  /* Off-screen rather than display:none — some bots skip hidden fields. */
  .enquiry__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry__grid {
    display: grid;
    gap: var(--dbm-space-md);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-bottom: var(--dbm-space-md);
  }

  .enquiry__field {
    display: grid;
    gap: 0.35rem;
  }

  .enquiry__field label {
    font-size: var(--dbm-text-sm);
    font-weight: 600;
  }

  .enquiry__field .req {
    color: var(--dbm-color-primary);
    margin-left: 0.15rem;
  }

  .enquiry__field input,
  .enquiry__field select,
  .enquiry__field textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--dbm-color-border);
    border-radius: var(--dbm-radius-sm);
    font: inherit;
    color: inherit;
    background: var(--dbm-color-background);
  }

  .enquiry__field textarea {
    resize: vertical;
  }

  .enquiry__field input:focus-visible,
  .enquiry__field select:focus-visible,
  .enquiry__field textarea:focus-visible {
    outline: 2px solid var(--dbm-color-primary);
    outline-offset: 1px;
  }

  .enquiry__actions {
    display: flex;
    align-items: center;
    gap: var(--dbm-space-md);
    flex-wrap: wrap;
    margin-top: var(--dbm-space-md);
  }

  .enquiry__route,
  .enquiry__footnote {
    font-size: var(--dbm-text-sm);
    color: var(--dbm-color-text-muted);
  }

  .enquiry__footnote {
    margin: var(--dbm-space-sm) 0 0;
  }

  /* Empty until something happens, so it takes no space on a fresh form. */
  .enquiry__status:empty {
    display: none;
  }

  .enquiry__status {
    margin: var(--dbm-space-sm) 0 0;
    font-weight: 600;
    font-size: var(--dbm-text-sm);
  }

  .enquiry__status[data-kind='ok'] {
    color: #1a7f3c;
  }

  .enquiry__status[data-kind='error'] {
    color: #b3261e;
  }

  .enquiry__unconfigured {
    color: var(--dbm-color-text-muted);
    font-style: italic;
  }
</style>

<script>
  /**
   * Composes the enquiry and hands it off.
   *
   * Progressive enhancement is deliberate here: with JS disabled the form
   * simply does not submit rather than silently losing what someone typed,
   * and the phone number in the header remains the way to make contact.
   */
  /**
   * Preselects the service someone arrived asking about.
   *
   * The services page links here as ?service=Dent+Removal, and retyping what
   * you just clicked is the kind of small friction that loses an enquiry.
   *
   * The value comes from the URL, so it is attacker-controllable and is only
   * ever assigned through value/textContent — never parsed as markup. It is
   * also length-capped, because a megabyte of query string in a WhatsApp
   * message is nobody's idea of an enquiry.
   */
  function prefillService(form: HTMLFormElement) {
    const requested = new URLSearchParams(location.search).get('service')?.trim();
    if (!requested) return;

    const service = requested.slice(0, 80);
    const select = form.querySelector<HTMLSelectElement>('select[name="service"]');

    if (select) {
      const match = Array.from(select.options).find(
        (option) => option.value.toLowerCase() === service.toLowerCase(),
      );

      if (match) {
        select.value = match.value;
      } else {
        // A service the list does not carry still names itself on the
        // enquiry, rather than arriving as "Not sure yet".
        const option = document.createElement('option');
        option.value = service;
        option.textContent = service;
        select.append(option);
        select.value = service;
      }
      return;
    }

    // No service picker on this form: say it in the message instead, ahead of
    // anything already typed rather than replacing it.
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    if (!message) return;

    const prefix = `Enquiry about: ${service}`;
    if (!message.value.includes(prefix)) {
      message.value = message.value ? `${prefix}\n\n${message.value}` : `${prefix}\n\n`;
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    prefillService(form);

    const status = form.querySelector<HTMLElement>('[data-enquiry-status]');

    /** Which button was pressed; submitter is unset for Enter-key submits. */
    let route: string | null = null;
    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-route]');
      if (button) route = button.dataset.route ?? null;
    });

    function say(text: string, kind: 'ok' | 'error' | '') {
      if (!status) return;
      status.textContent = text;
      status.dataset.kind = kind;
    }

    /** The enquiry as the business reads it, used by both routes. */
    function compose(data: FormData) {
      const value = (name: string) => String(data.get(name) ?? '').trim();
      return {
        payload: {
          name: value('name'),
          mobile: value('mobile'),
          email: value('email'),
          service: value('service'),
          message: value('message'),
          website: value('website'),
        },
        text: [
          `Name: ${value('name')}`,
          `Mobile: ${value('mobile')}`,
          value('email') ? `Email: ${value('email')}` : '',
          value('service') ? `Service: ${value('service')}` : '',
          value('message') ? `Details: ${value('message')}` : '',
        ]
          .filter(Boolean)
          .join('\n'),
      };
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const { payload, text } = compose(new FormData(form));
      const endpoint = document.body.dataset.enquiryEndpoint;
      const siteId = document.body.dataset.siteId;
      const canPost = Boolean(endpoint && siteId);

      // Enter with no button pressed follows whichever route is primary.
      const chosen = route ?? (form.dataset.whatsapp ? 'whatsapp' : 'email');
      route = null;

      const post = () =>
        fetch(endpoint!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ siteId, ...payload }),
        });

      if (chosen === 'email') {
        /*
         * Awaited, unlike the WhatsApp route. Nothing else happens on this
         * path, so the response is the only thing that can tell someone their
         * enquiry arrived — silence would read as a dead button.
         */
        if (!canPost) {
          // No endpoint configured: fall back to the visitor's mail client
          // rather than pretending to have sent something.
          const to = form.dataset.email;
          const subject = form.dataset.subject || 'Enquiry';
          if (to) {
            window.location.href =
              `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
          } else {
            say('Email is not set up for this site — please use WhatsApp or call us.', 'error');
          }
          return;
        }

        const buttons = form.querySelectorAll<HTMLButtonElement>('button[type="submit"]');
        buttons.forEach((button) => (button.disabled = true));
        say('Sending…', '');

        try {
          const response = await post();
          if (!response.ok) throw new Error(String(response.status));
          say('Thank you — your enquiry has been sent. We will be in touch shortly.', 'ok');
          form.reset();
        } catch {
          say('Could not send just now. Please try WhatsApp, or call us directly.', 'error');
        } finally {
          buttons.forEach((button) => (button.disabled = false));
        }
        return;
      }

      /*
       * WhatsApp: record in the background and hand off immediately. Opening
       * the app is what the visitor is waiting for and must not be delayed by
       * a call to a service they never asked about; keepalive lets the request
       * outlive the tab navigating away.
       */
      if (canPost) {
        fetch(endpoint!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({ siteId, ...payload }),
        }).catch(() => {
          /* Silent: the handoff below is the path that matters here. */
        });
      }

      const whatsapp = form.dataset.whatsapp;
      window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  });
</script>
