---
import type { FloatingContactBarContent } from '../../types/blocks';

type Props = FloatingContactBarContent;

const { call, whatsapp, facebook, instagram, youtube } = Astro.props;

/**
 * Circular brand buttons stacked down the right edge, matching the pattern
 * these businesses' sites use. Deliberately the same shape on mobile — a
 * full-width bottom bar covers page content and reads as app chrome rather
 * than as the client's own contact links.
 *
 * SVG marks are inlined rather than loaded from an icon CDN, so the built
 * site stays a self-contained artifact with no external request.
 */
const channels = [
  { key: 'youtube', color: '#ff0000', channel: youtube },
  // Instagram's mark is a gradient, not a flat magenta. A solid fill is the
  // single most obvious tell that these are stand-in icons.
  {
    key: 'instagram',
    color:
      'radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%)',
    channel: instagram,
  },
  { key: 'facebook', color: '#1877f2', channel: facebook },
  { key: 'whatsapp', color: '#25d366', channel: whatsapp },
  { key: 'call', color: '#4caf50', channel: call },
].filter((entry) => entry.channel?.url);
---

{
  channels.length > 0 && (
    <aside class="floatbar" aria-label="Contact us">
      <ul class="floatbar__list">
        {channels.map(({ key, color, channel }) => (
          <li>
            <a
              class="floatbar__link"
              style={`--floatbar-color: ${color}`}
              href={channel!.url}
              aria-label={channel!.label}
              title={channel!.label}
              target={channel!.url.startsWith('http') ? '_blank' : undefined}
              rel={channel!.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {key === 'call' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.95 21c-2.17 0-4.3-.5-6.4-1.49a20.2 20.2 0 0 1-5.6-4A20.2 20.2 0 0 1 4 9.9 15.1 15.1 0 0 1 2.5 3.5c0-.32.1-.58.32-.79.21-.2.47-.31.78-.31h3.4c.25 0 .47.08.66.25.19.17.3.38.34.63l.55 2.94c.04.27.03.5-.04.7-.06.2-.17.36-.33.5L5.9 9.83a17.4 17.4 0 0 0 3.15 3.98 16.4 16.4 0 0 0 3.9 2.85l2.35-2.35c.16-.16.35-.28.58-.35.23-.07.46-.09.68-.05l2.9.59c.26.06.47.19.62.38.15.19.23.41.23.65v3.37c0 .31-.1.57-.31.78-.21.22-.47.32-.79.32z"/></svg>
              )}
              {key === 'whatsapp' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.29-.76.95-.93 1.15-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.29-.02-.45.13-.6.13-.13.3-.34.44-.51.15-.17.2-.29.3-.49.1-.2.05-.37-.02-.51-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5-.17-.01-.37-.01-.56-.01-.2 0-.51.07-.78.36-.27.29-1.02 1-1.02 2.44s1.05 2.83 1.2 3.03c.15.2 2.06 3.15 5 4.42.7.3 1.24.48 1.67.62.7.22 1.34.19 1.84.12.56-.09 1.75-.72 2-1.41.24-.69.24-1.28.17-1.4-.07-.13-.27-.2-.56-.35zM12 2C6.48 2 2 6.48 2 12c0 1.77.46 3.42 1.27 4.86L2 22l5.3-1.24A9.93 9.93 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18.2c-1.6 0-3.1-.43-4.4-1.18l-.31-.18-3.14.74.75-3.06-.2-.32A8.16 8.16 0 0 1 3.8 12c0-4.52 3.68-8.2 8.2-8.2s8.2 3.68 8.2 8.2-3.68 8.2-8.2 8.2z"/></svg>
              )}
              {key === 'facebook' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 21v-8.2h2.76l.41-3.2H13.4V7.55c0-.93.26-1.56 1.59-1.56h1.7V3.13c-.3-.04-1.3-.13-2.47-.13-2.45 0-4.13 1.5-4.13 4.24V9.6H7.32v3.2h2.77V21h3.31z"/></svg>
              )}
              {key === 'instagram' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 2.12c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.18.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.41-.35 1.03-.4 2.18-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.05 1.15.24 1.77.4 2.18.22.55.47.94.88 1.35.41.41.8.66 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.18-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.41.35-1.03.4-2.18.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4-1.24-.06-1.61-.07-4.75-.07zm0 3.6a6.12 6.12 0 1 1 0 12.24 6.12 6.12 0 0 1 0-12.24zm0 10.1a3.98 3.98 0 1 0 0-7.96 3.98 3.98 0 0 0 0 7.96zm7.79-10.34a1.43 1.43 0 1 1-2.86 0 1.43 1.43 0 0 1 2.86 0z"/></svg>
              )}
              {key === 'youtube' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.58 7.19a2.5 2.5 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.81.42a2.5 2.5 0 0 0-1.77 1.77C2 8.75 2 12 2 12s0 3.25.42 4.81a2.5 2.5 0 0 0 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.81-.42a2.5 2.5 0 0 0 1.77-1.77C22 15.25 22 12 22 12s0-3.25-.42-4.81zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  /* Vertically centred on the right edge and flush-stacked, matching the
     reference rather than a floating cluster in the corner. */
  .floatbar {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 60;
  }

  .floatbar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Rounded squares, not circles. */
  .floatbar__link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    color: #fff;
    background: var(--floatbar-color);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .floatbar__link svg {
    width: 22px;
    height: 22px;
  }

  .floatbar__link:hover,
  .floatbar__link:focus-visible {
    transform: translateX(-3px);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.35);
  }

  /* Same shape on phones, just tighter — a full-width bottom bar would
     cover page content and read as app chrome. */
  @media (max-width: 767px) {
    .floatbar__list {
      gap: 3px;
    }

    .floatbar__link {
      width: 34px;
      height: 34px;
      border-radius: 5px;
    }

    .floatbar__link svg {
      width: 19px;
      height: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floatbar__link {
      transition: none;
    }

    .floatbar__link:hover,
    .floatbar__link:focus-visible {
      transform: none;
    }
  }
</style>
