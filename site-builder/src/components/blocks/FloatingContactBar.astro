---
import type { FloatingContactBarContent } from '../../types/blocks';

type Props = FloatingContactBarContent;

const { call, whatsapp, facebook, instagram, youtube } = Astro.props;

/**
 * Fixed channel order, each with its own brand colour and a real SVG mark —
 * inlined rather than loaded from an icon font or CDN, so the built site
 * stays a self-contained artifact with no external request.
 *
 * Rendering is driven by this list rather than by iterating the props
 * object, so the visual order stays stable no matter what order the keys
 * arrive in from Supabase.
 */
const channels = [
  { key: 'call', color: '#0e9f6e', channel: call },
  { key: 'whatsapp', color: '#25d366', channel: whatsapp },
  { key: 'facebook', color: '#1877f2', channel: facebook },
  { key: 'instagram', color: '#d6249f', channel: instagram },
  { key: 'youtube', color: '#ff0000', channel: youtube },
].filter((entry) => entry.channel?.url);
---

{
  channels.length > 0 && (
    <aside class="floatbar" aria-label="Contact us">
      <ul class="floatbar__list">
        {channels.map(({ key, color, channel }) => (
          <li>
            <a
              class={`floatbar__link floatbar__link--${key}`}
              style={`--floatbar-color: ${color}`}
              href={channel!.url}
              title={channel!.label}
              target={channel!.url.startsWith('http') ? '_blank' : undefined}
              rel={channel!.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <span class="floatbar__icon" aria-hidden="true">
                {key === 'call' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
                )}
                {key === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.1c-1.6 0-3.1-.4-4.5-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.1 8.1 0 1 1 7.3 3.9zm4.5-6c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8.9-.2.2-.3.2-.5.1-.2-.1-1-.4-2-1.2-.7-.6-1.2-1.4-1.4-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 2 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
                )}
                {key === 'facebook' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.2-1.5 1.6-1.5H17V3.7c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.2H8v3.1h2.6v8h2.9z"/></svg>
                )}
                {key === 'instagram' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
                )}
                {key === 'youtube' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7z"/><path d="M10 15.3V8.7l5.8 3.3-5.8 3.3z" fill="#fff"/></svg>
                )}
              </span>
              <span class="floatbar__label">{channel!.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .floatbar {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 60;
  }

  .floatbar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .floatbar__link {
    display: flex;
    align-items: center;
    gap: var(--dbm-space-xs);
    /* Collapsed to icon width; the label slides out on hover. */
    width: 48px;
    height: 48px;
    padding-left: 14px;
    overflow: hidden;
    white-space: nowrap;
    text-decoration: none;
    color: #fff;
    background: var(--floatbar-color, var(--dbm-color-secondary));
    border-radius: var(--dbm-radius-sm) 0 0 var(--dbm-radius-sm);
    box-shadow: var(--dbm-shadow-sm);
    transition: width 0.2s ease, filter 0.2s ease;
  }

  .floatbar__link:hover,
  .floatbar__link:focus-visible {
    width: 160px;
    filter: brightness(0.92);
  }

  .floatbar__icon {
    display: inline-flex;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .floatbar__icon svg {
    width: 100%;
    height: 100%;
  }

  .floatbar__label {
    font-size: var(--dbm-text-sm);
    font-weight: 600;
  }

  /* On phones, sit along the bottom edge as a full-width action bar. */
  @media (max-width: 767px) {
    .floatbar {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      transform: none;
    }

    .floatbar__list {
      flex-direction: row;
      gap: 0;
    }

    /* The li is the flex child, so it carries the growth — not the link. */
    .floatbar__list > li {
      flex: 1;
      display: flex;
    }

    .floatbar__link {
      width: 100%;
      justify-content: center;
      padding-left: 0;
      border-radius: 0;
    }

    .floatbar__link:hover,
    .floatbar__link:focus-visible {
      width: auto;
    }

    .floatbar__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floatbar__link {
      transition: none;
    }
  }
</style>
