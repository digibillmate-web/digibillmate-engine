---
import type { ContactLocationContent } from '../../types/blocks';

type Props = ContactLocationContent;

const { heading, intro, address, phone, email, hours, mapEmbedUrl, cta } = Astro.props;

const telHref = phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : undefined;

/*
 * Google only renders its own embed URLs in an iframe. Everything else it
 * refuses to frame, and the refusal is silent — the iframe simply stays
 * blank, which looks like a broken site rather than a wrong setting.
 *
 * What people actually paste is the Share link (maps.app.goo.gl/...) or the
 * address-bar URL, because that is what Google's own Share button gives you.
 * A short link cannot be resolved here, so rather than framing something that
 * will not load, fall back to a query embed built from the address — which
 * needs no API key — and failing that, offer a plain link out.
 */
const rawMap = mapEmbedUrl?.trim();
const isEmbeddable = Boolean(rawMap && /\/maps\/embed|output=embed/.test(rawMap));

const mapSrc = isEmbeddable
  ? rawMap
  : address
    ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
    : undefined;

// A link that was given but cannot be framed still deserves to be reachable.
const mapLink = !isEmbeddable && rawMap ? rawMap : undefined;

// `hours` is free text in Supabase, but the admin tool may later store a
// structured table. Support both.
const hoursText = typeof hours === 'string' ? hours.trim() : undefined;
const hoursRows = Array.isArray(hours) ? hours : undefined;

/*
 * Contact details as icon cards, matching the reference's contact page.
 *
 * Built from whatever is actually stored — a card for an empty field would be
 * an icon and a heading over nothing, which looks like a rendering fault
 * rather than an unfilled field.
 */
const ICONS = {
  phone:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.95 21c-2.17 0-4.3-.5-6.4-1.49a20.2 20.2 0 0 1-5.6-4A20.2 20.2 0 0 1 4 9.9 15.1 15.1 0 0 1 2.5 3.5c0-.32.1-.58.32-.79.21-.2.47-.31.78-.31h3.4c.25 0 .47.08.66.25.19.17.3.38.34.63l.55 2.94c.04.27.03.5-.04.7-.06.2-.17.36-.33.5L5.9 9.83a17.4 17.4 0 0 0 3.15 3.98 16.4 16.4 0 0 0 3.9 2.85l2.35-2.35c.16-.16.35-.28.58-.35.23-.07.46-.09.68-.05l2.9.59c.26.06.47.19.62.38.15.19.23.41.23.65v3.37c0 .31-.1.57-.31.78-.21.22-.47.32-.79.32z"/></svg>',
  location:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.24-8 4.76-8-4.76V6l8 4.76L20 6z"/></svg>',
  clock:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.6V6h-2v7.4l5.2 3.1 1-1.7z"/></svg>',
};

const cards = [
  phone ? { title: 'Phone', value: phone, href: telHref, icon: ICONS.phone } : null,
  address ? { title: 'Address', value: address, icon: ICONS.location } : null,
  email ? { title: 'Email', value: email, href: `mailto:${email}`, icon: ICONS.mail } : null,
  hoursText ? { title: 'Opening hours', value: hoursText, icon: ICONS.clock } : null,
].filter((card): card is NonNullable<typeof card> => card !== null);
---

<section class="contact dbm-section" id="contact">
  <div class="dbm-container">
    <h2 class="dbm-heading">{heading}</h2>
    {intro && <p class="dbm-intro">{intro}</p>}

    {cards.length > 0 && (
      <ul class="contact__cards" data-stagger>
        {cards.map((card) => (
          <li class="contact__card dbm-surface">
            <span class="contact__icon" aria-hidden="true" set:html={card.icon} />
            <h3 class="contact__card-title">{card.title}</h3>
            <div class="contact__card-body">
              {card.href ? <a href={card.href}>{card.value}</a> : card.value}
            </div>
          </li>
        ))}
      </ul>
    )}

    {hoursRows && hoursRows.length > 0 && (
      <table class="contact__hours">
        <caption>Opening hours</caption>
        <tbody>
          {hoursRows.map((slot) => (
            <tr>
              <th scope="row">{slot.days}</th>
              <td>{slot.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {cta && <a class="dbm-btn dbm-btn--primary contact__cta" href={cta.href}>{cta.label}</a>}
  </div>

  {/* Full-bleed, the way the reference runs its map — a boxed map reads as a
      screenshot, a full-width one reads as "here we are". */}
  {mapSrc && (
    <div class="contact__map">
      <iframe
        src={mapSrc}
        title={`Map showing the location of ${heading}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  )}

  {mapLink && (
    <p class="contact__maplink">
      <a href={mapLink} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
    </p>
  )}
</section>

<style>
  .contact__inner--split {
    display: grid;
    gap: var(--dbm-space-xl);
    align-items: start;
  }

  .contact__details {
    margin: 0 0 var(--dbm-space-lg);
  }

  .contact__row {
    display: flex;
    gap: var(--dbm-space-sm);
    padding-block: var(--dbm-space-xs);
    border-bottom: 1px solid var(--dbm-color-border);
  }

  .contact__row dt {
    flex: 0 0 6.5rem;
    font-weight: 600;
    color: var(--dbm-color-text-muted);
    font-size: var(--dbm-text-sm);
  }

  .contact__row dd {
    margin: 0;
  }

  .contact__row a {
    color: var(--dbm-color-primary);
    text-decoration: none;
  }

  .contact__row a:hover {
    text-decoration: underline;
  }

  .contact__hours-text {
    margin: 0 0 var(--dbm-space-lg);
    font-size: var(--dbm-text-sm);
  }

  .contact__hours-label {
    display: block;
    font-weight: 600;
    color: var(--dbm-color-text-muted);
  }

  .contact__hours {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--dbm-space-lg);
    font-size: var(--dbm-text-sm);
  }

  .contact__hours caption {
    text-align: left;
    font-weight: 600;
    color: var(--dbm-color-text-muted);
    padding-bottom: var(--dbm-space-xs);
  }

  .contact__hours th {
    text-align: left;
    font-weight: 500;
    padding-block: 0.3em;
  }

  .contact__hours td {
    text-align: right;
    padding-block: 0.3em;
  }

  /* Detail cards, matching the reference's contact page. */
  .contact__cards {
    list-style: none;
    margin: 0 0 var(--dbm-space-lg);
    padding: 0;
    display: grid;
    gap: var(--dbm-space-md);
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .contact__card {
    text-align: center;
    padding: var(--dbm-space-lg);
    border: 1px solid var(--dbm-color-border);
    border-radius: var(--dbm-radius-lg);
    background: var(--dbm-color-background);
    box-shadow: var(--dbm-shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--dbm-shadow-md);
  }

  .contact__icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--dbm-space-sm);
    border-radius: 50%;
    background: var(--dbm-color-primary);
    color: var(--dbm-color-primary-contrast);
  }

  .contact__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .contact__card-title {
    font-family: var(--dbm-font-heading);
    font-size: var(--dbm-text-lg);
    margin: 0 0 var(--dbm-space-xs);
  }

  .contact__card-body {
    color: var(--dbm-color-text-muted);
    /* Addresses carry their own line breaks. */
    white-space: pre-line;
  }

  .contact__card-body a {
    color: inherit;
    text-decoration: none;
  }

  .contact__card-body a:hover {
    color: var(--dbm-color-primary);
    text-decoration: underline;
  }

  /*
   * Full-bleed map. Sits outside the container so it spans the viewport;
   * a boxed map reads as a screenshot of a map rather than as a location.
   */
  .contact__map {
    margin-top: var(--dbm-space-xl);
  }

  .contact__map iframe {
    display: block;
    width: 100%;
    height: 400px;
    border: 0;
  }

  .contact__maplink {
    text-align: center;
    margin: var(--dbm-space-md) 0 0;
  }

  .contact__maplink a {
    color: var(--dbm-color-primary);
  }

  /*
   * The sweep from the Vision/Mission cards, so the contact page moves the
   * same way the about page does.
   */
  .contact__card {
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .contact__card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: 100%;
    z-index: 0;
    background: var(--dbm-color-primary);
    border-radius: 500px 500px 0 0;
    opacity: 0;
    transition: top 0.4s ease-in-out, border-radius 0.4s ease-in-out, opacity 0.4s ease-in-out;
  }

  .contact__card:hover::before,
  .contact__card:focus-within::before {
    top: 0;
    border-radius: 0;
    opacity: 1;
  }

  /* Above the rising panel, which is a positioned descendant and would
     otherwise paint over the text it is meant to sit behind. */
  .contact__card > * {
    position: relative;
    z-index: 1;
  }

  .contact__card :is(.contact__card-title, .contact__card-body) {
    transition: color 0.4s ease-in-out;
  }

  .contact__card:is(:hover, :focus-within)
    :is(.contact__card-title, .contact__card-body) {
    color: var(--dbm-color-primary-contrast);
  }

  /* The icon already carries the primary fill; on the panel it would vanish
     into it, so it inverts. */
  .contact__card:is(:hover, :focus-within) .contact__icon {
    background: var(--dbm-color-primary-contrast);
    color: var(--dbm-color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__card::before,
    .contact__card :is(.contact__card-title, .contact__card-body) {
      transition: none;
    }

    .contact__card::before {
      border-radius: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__card,
    .contact__card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
