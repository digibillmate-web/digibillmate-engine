---
/**
 * Renders an ordered list of block instances by looking each one's type up in
 * the block registry.
 *
 * An unknown type is a hard error in every mode, dev and production alike.
 * Skipping it would let a green build publish a page silently missing a
 * section — worse than not shipping at all, because nothing signals it.
 * Drift between `block_definitions.key` and this registry must fail loudly.
 */
import { blockRegistry } from './blocks/index';
import type { BlockContent } from '../types/blocks';

interface Props {
  blocks: BlockContent[];
}

const { blocks } = Astro.props;

/**
 * Background is chosen per block instance, but only from theme roles — never
 * an arbitrary colour. A block picks the part it plays ("this is a tinted
 * band"); the theme decides what that looks like. Storing a raw hex here would
 * let a block drift away from the palette the moment the theme changed.
 */
const BACKGROUNDS = new Set(['surface', 'primary', 'secondary', 'default']);

function backgroundClass(settings: unknown): string | undefined {
  if (!settings || typeof settings !== 'object') return undefined;

  const value = (settings as { background?: unknown }).background;
  if (typeof value !== 'string') return undefined;

  const name = value.trim().toLowerCase();
  if (!BACKGROUNDS.has(name) || name === 'default') return undefined;

  return `blockbg blockbg--${name}`;
}
---

{
  blocks.map((block) => {
    const Component = blockRegistry[block.type];

    if (!Component) {
      const known = Object.keys(blockRegistry).join(', ');

      throw new Error(
        `Unknown block type "${block.type}". No component is registered for it. ` +
          `Registered keys (must match block_definitions.key): ${known}`,
      );
    }

    // Content shape is guaranteed by the BlockContent discriminated union.
    const Block = Component as any;
    const wrapper = backgroundClass((block as { settings?: unknown }).settings);

    // Chrome is present on every page and sits outside the reading flow, so
    // fading it in would delay the header on each navigation for no gain.
    const isChrome = ['header_nav', 'footer', 'floating_contact_bar'].includes(block.type);
    const reveal = isChrome ? undefined : true;

    // Only wrapped when a background is chosen, so the default output stays as
    // it was rather than gaining an empty div everywhere.
    return wrapper ? (
      <div class={wrapper} data-reveal={reveal}>
        <Block {...block.content} />
      </div>
    ) : reveal ? (
      <div data-reveal>
        <Block {...block.content} />
      </div>
    ) : (
      <Block {...block.content} />
    );
  })
}
