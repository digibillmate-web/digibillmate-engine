---
import '../styles/fonts.ts';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Theme preset from the site's archetype: CSS custom property overrides. */
  theme?: Record<string, string>;
}

const { title, description, theme } = Astro.props;

// Every theme key is exported as a --dbm-* custom property, including
// favicon-url, which isn't a CSS value — it belongs in a <link> tag instead.
// Filtered out here so it doesn't also get written into the inline <style>.
const FAVICON_VAR = '--dbm-favicon-url';
const faviconUrl = theme?.[FAVICON_VAR];

// Theme keys that are metadata, not CSS values — they belong in <head> tags
// rather than in the custom property block.
const NON_CSS_VARS = new Set([FAVICON_VAR, '--dbm-seo-title', '--dbm-seo-description']);

const themeStyle = theme
  ? Object.entries(theme)
      .filter(([key]) => !NON_CSS_VARS.has(key))
      .map(([key, value]) => `${key}: ${value};`)
      .join(' ')
  : undefined;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {faviconUrl && <link rel="icon" href={faviconUrl} />}
    {/*
      `:root:root` doubles specificity on purpose: Astro injects theme.css
      after this tag, so a plain `:root` here would lose to the defaults.
    */}
    {themeStyle && <style is:inline set:html={`:root:root { ${themeStyle} }`}></style>}
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
