---
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Theme preset from the site's archetype: CSS custom property overrides. */
  theme?: Record<string, string>;
}

const { title, description, theme } = Astro.props;

const themeStyle = theme
  ? Object.entries(theme)
      .map(([key, value]) => `${key}: ${value};`)
      .join(' ')
  : undefined;

// Families the browser already has; never worth a network request.
const SYSTEM_FAMILIES = new Set([
  'system-ui', 'ui-sans-serif', 'ui-serif', 'ui-monospace', 'sans-serif',
  'serif', 'monospace', 'cursive', 'fantasy', '-apple-system',
  'blinkmacsystemfont', 'segoe ui', 'roboto', 'helvetica', 'helvetica neue',
  'arial', 'georgia', 'times new roman', 'courier new',
]);

/**
 * Pull the first (preferred) family out of each font token in the theme, so an
 * archetype that asks for "Poppins, sans-serif" actually gets Poppins loaded.
 */
const webFonts = [
  ...new Set(
    Object.entries(theme ?? {})
      .filter(([key]) => key.startsWith('--dbm-font-'))
      .map(([, value]) => value.split(',')[0]?.trim().replace(/^['"]|['"]$/g, '') ?? '')
      .filter((family) => family && !SYSTEM_FAMILIES.has(family.toLowerCase())),
  ),
];

const googleFontsHref =
  webFonts.length > 0
    ? `https://fonts.googleapis.com/css2?${webFonts
        .map((family) => `family=${encodeURIComponent(family).replace(/%20/g, '+')}:wght@400;600;700`)
        .join('&')}&display=swap`
    : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {googleFontsHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={googleFontsHref} />
      </>
    )}
    {/*
      `:root:root` doubles specificity on purpose: Astro injects theme.css
      after this tag, so a plain `:root` here would lose to the defaults.
    */}
    {themeStyle && <style is:inline set:html={`:root:root { ${themeStyle} }`}></style>}
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
