---
import '../styles/fonts.ts';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Theme preset from the site's archetype: CSS custom property overrides. */
  theme?: Record<string, string>;
  /** This page's own accent overrides, layered over the site theme. */
  pageTheme?: Record<string, string>;
  /** This page's scroll-reveal style. */
  revealAnimation?: string;
  /** Identifies the site to the enquiry endpoint. */
  siteId?: string;
  /** Absent when the platform has no intake endpoint configured. */
  enquiryEndpoint?: string;
}

const { title, description, theme, pageTheme, revealAnimation, siteId, enquiryEndpoint } =
  Astro.props;

// Every theme key is exported as a --dbm-* custom property, including
// favicon-url, which isn't a CSS value — it belongs in a <link> tag instead.
// Filtered out here so it doesn't also get written into the inline <style>.
const FAVICON_VAR = '--dbm-favicon-url';
const faviconUrl = theme?.[FAVICON_VAR];

// Theme keys that are metadata, not CSS values — they belong in <head> tags
// rather than in the custom property block.
const NON_CSS_VARS = new Set([FAVICON_VAR, '--dbm-seo-title', '--dbm-seo-description']);

const toDeclarations = (values?: Record<string, string>) =>
  values
    ? Object.entries(values)
        .filter(([key]) => !NON_CSS_VARS.has(key))
        .map(([key, value]) => `${key}: ${value};`)
        .join(' ')
    : '';

const themeStyle = toDeclarations(theme);

/*
 * Page overrides are written as a second, more specific rule rather than
 * merged into the site theme above. Keeping them separate means the built
 * HTML shows what the site sets and what this page changes, instead of one
 * flattened palette that gives no clue which values are page-specific.
 */
const pageStyle = toDeclarations(pageTheme);

/*
 * Chrome effects, decided here because the theme is known at render time and
 * CSS cannot branch on a custom property to decide whether an element exists.
 *
 * A page override wins, the same as colours: a stark landing page can drop the
 * preloader the rest of the site uses.
 */
const effect = (key: string) => (pageTheme?.[key] ?? theme?.[key] ?? '').trim();

const preloader = effect('--dbm-preloader');
const cursorGlow = effect('--dbm-cursor-glow');
const ambientGlow = effect('--dbm-ambient-glow');

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {faviconUrl && <link rel="icon" href={faviconUrl} />}
    {/*
      `:root:root` doubles specificity on purpose: Astro injects theme.css
      after this tag, so a plain `:root` here would lose to the defaults.
    */}
    {themeStyle && <style is:inline set:html={`:root:root { ${themeStyle} }`}></style>}
    {/* One step more specific than the site theme, so the page wins. */}
    {pageStyle && <style is:inline set:html={`:root:root:root { ${pageStyle} }`}></style>}
  </head>
  <body
    data-reveal-anim={revealAnimation}
    data-site-id={siteId}
    data-enquiry-endpoint={enquiryEndpoint}
  >
    {/*
      The preloader clears itself with a CSS animation, not with script.
      A loading screen that depends on JS to disappear is one broken bundle
      away from a permanently blank site — the single worst failure a site can
      have, because it hides everything and looks like an outage.

      The script below only shortens it once the page is genuinely ready.
    */}
    {preloader === 'ring' && (
      <div class="preload" data-preload aria-hidden="true">
        <span class="preload__ring"></span>
      </div>
    )}

    {/*
      Ambient glow: two large blurred blobs drifting behind everything.

      Fixed rather than per-section, so the colour moves independently of the
      scroll and reads as depth in the page rather than as decoration bolted
      onto one band. Behind all content and inert to the pointer.
    */}
    {(ambientGlow === 'subtle' || ambientGlow === 'strong') && (
      <div class={`ambient ambient--${ambientGlow}`} aria-hidden="true">
        <span class="ambient__blob ambient__blob--a"></span>
        <span class="ambient__blob ambient__blob--b"></span>
      </div>
    )}

    {/* Desktop pointers only; the CSS keeps it out of the way on touch. */}
    {(cursorGlow === 'soft' || cursorGlow === 'strong') && (
      <div class={`cursorglow cursorglow--${cursorGlow}`} data-cursor-glow aria-hidden="true"></div>
    )}

    <main>
      <slot />
    </main>

    <script>
      /**
       * Reveals sections as they scroll into view.
       *
       * Two mechanisms on purpose, because the failure here is content that
       * stays permanently invisible:
       *
       *  - The hiding class is added by JS, never in the markup, so a script
       *    that never runs leaves the page fully visible rather than blank.
       *  - An observer handles the normal case, and a sweep catches anything
       *    the observer missed. A fast wheel scroll or an anchor jump can move
       *    past a section between frames without it ever intersecting, and
       *    that section would otherwise never appear again.
       */
      const root = document.documentElement;

      /*
       * Clears the loading screen once the page is actually ready.
       *
       * The CSS already dismisses it on a timer, so this only shortens the
       * wait — nothing here is load-bearing, and a thrown error above or
       * below cannot leave the screen stuck.
       */
      const preload = document.querySelector<HTMLElement>('[data-preload]');
      if (preload) {
        const clear = () => {
          preload.classList.add('is-done');
          // Removed outright once faded, so a full-screen element can never
          // sit over the page swallowing clicks.
          window.setTimeout(() => preload.remove(), 600);
        };

        if (document.readyState === 'complete') clear();
        else window.addEventListener('load', clear, { once: true });

        /*
         * A hard ceiling. `load` waits for every image, and one slow photo on
         * a phone connection would otherwise hold the whole page behind a
         * spinner. Two seconds is longer than the CSS fallback, so this only
         * ever fires when the animation is not running either.
         */
        window.setTimeout(clear, 2000);
      }

      /*
       * Halo following the pointer.
       *
       * Positioned in a rAF rather than on every mousemove: pointer events
       * fire far faster than the screen refreshes, and writing styles on each
       * one makes the page feel heavier, which is the opposite of the point.
       *
       * It stays invisible until the pointer actually moves, so a page nobody
       * has touched does not carry a glow parked in its top-left corner.
       */
      const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
      if (glow && window.matchMedia('(pointer: fine)').matches) {
        let x = 0;
        let y = 0;
        let queued = false;

        const paint = () => {
          queued = false;
          glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
        };

        window.addEventListener(
          'pointermove',
          (event) => {
            x = event.clientX;
            y = event.clientY;
            glow.classList.add('is-active');
            if (queued) return;
            queued = true;
            requestAnimationFrame(paint);
          },
          { passive: true },
        );
      }

      /**
       * Splits section headings into per-character spans so they can slide in
       * one letter at a time, the way the reference site does.
       *
       * Done in script rather than in the markup because a heading is author
       * content: the components emit a plain string and this is presentation.
       *
       * Accessibility: a heading read out character by character is worse than
       * no animation at all, so the original text is set as the accessible
       * name and every generated span is hidden from assistive tech.
       */
      for (const heading of document.querySelectorAll<HTMLElement>('.dbm-heading')) {
        const text = heading.textContent?.trim();
        // Only plain-text headings; anything with markup inside is left alone
        // rather than having its elements flattened away.
        if (!text || heading.children.length > 0) continue;

        heading.setAttribute('aria-label', text);

        const frag = document.createDocumentFragment();
        let index = 0;

        text.split(/(\s+)/).forEach((chunk) => {
          if (/^\s+$/.test(chunk)) {
            frag.append(document.createTextNode(' '));
            return;
          }
          const word = document.createElement('span');
          word.className = 'word';
          word.setAttribute('aria-hidden', 'true');
          for (const character of Array.from(chunk)) {
            const span = document.createElement('span');
            span.className = 'char';
            span.style.setProperty('--char-i', String(index++));
            span.textContent = character;
            word.append(span);
          }
          frag.append(word);
        });

        heading.replaceChildren(frag);

        // Its own reveal target: a heading can sit far below the point where
        // its section enters view, and the letters should animate when the
        // heading is looked at, not when the section starts to appear.
        heading.setAttribute('data-reveal-text', '');
      }

      const targets = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-text]'),
      );

      if (targets.length > 0) {
        root.classList.add('has-reveal');

        const reveal = (el: Element) => el.classList.add('is-revealed');

        // Anything at or above the fold has been reached, whether or not the
        // observer saw it happen.
        let queued = false;
        const sweep = () => {
          queued = false;
          for (const target of targets) {
            if (target.classList.contains('is-revealed')) continue;
            if (target.getBoundingClientRect().top < window.innerHeight * 0.92) {
              reveal(target);
            }
          }
        };

        const scheduleSweep = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                reveal(entry.target);
                // One-shot: re-animating on every pass makes scrolling back up
                // feel broken rather than lively.
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
          );

          for (const target of targets) observer.observe(target);
        }

        window.addEventListener('scroll', scheduleSweep, { passive: true });
        window.addEventListener('resize', scheduleSweep);

        /*
         * The first sweep waits for layout to settle.
         *
         * Running it immediately measured positions before the images had
         * loaded, when everything below the hero still sat near the top of the
         * document. Sections far below the fold passed the "already reached"
         * test, revealed, and then got pushed down by several hundred pixels
         * of image — so by the time anyone scrolled to them their animation
         * had long finished and they simply appeared, fully formed.
         *
         * The observer covers the interim, and it measures for itself.
         */
        if (document.readyState === 'complete') scheduleSweep();
        else window.addEventListener('load', scheduleSweep, { once: true });
      }
    </script>
  </body>
</html>
